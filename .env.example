# Porta HTTP do servidor
PORT=

# Redis — guarda o AUTH_ID/DOMAIN de cada sessão (usuário) do app Bitrix24.
# Rode "docker compose up -d" para subir um Redis local rapidamente.
REDIS_URL=

# Cookie de sessão (identifica cada usuário para o Redis). Troque o segredo
# em qualquer ambiente que não seja apenas o seu computador de dev.
SESSION_COOKIE_NAME=bx_session
SESSION_TTL_SECONDS=3600
SESSION_SECRET=

# Kimi API (endpoint compatível com o SDK da OpenAI). Preencha com sua key.
OPENAI_API_KEY=
OPENAI_URL=https://api.moonshot.ai/v1
OPENAI_MODEL=kimi-k2.6

# Servidor MCP do Bitrix24 (opcional). Deixe vazio enquanto não estiver
# configurado — o bot usa apenas o catálogo estático de métodos nesse caso.
BITRIX_MCP_URL=
BITRIX_MCP_TOKEN=
